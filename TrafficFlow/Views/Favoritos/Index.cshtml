@model List<TrafficFlow.Modelos.RutaFavorita>

@{
    ViewData["Title"] = "Rutas Favoritas";
    Layout = null;
    var rutas = ViewBag.Rutas as List<TrafficFlow.Modelos.Ruta> ?? new();
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/estilosPrincipales.css" />
    <style>
            .contenedor-favoritos {
                display: flex;
                flex: 1;
                overflow: hidden;
            }

            .panel-agregar {
                width: 360px;
                background: var(--color-panel);
                border-right: 1px solid var(--color-borde);
                padding: 24px;
                overflow-y: auto;
                display: flex;
                flex-direction: column;
                gap: 16px;
            }

            .panel-lista {
                flex: 1;
                padding: 24px;
                overflow-y: auto;
            }

            .campo {
                display: flex;
                flex-direction: column;
                gap: 6px;
            }

            .campo label {
                font-size: 0.8rem;
                color: #8b949e;
            }

            .campo select {
                background: var(--color-fondo);
                color: var(--color-texto);
                border: 1px solid var(--color-borde);
                padding: 10px;
                border-radius: 6px;
                transition: border-color 0.2s;
            }

            .campo select:focus {
                outline: none;
                border-color: var(--color-azul);
            }

            .btn-agregar {
                background: var(--color-azul);
                color: white;
                border: none;
                padding: 12px;
                border-radius: 8px;
                cursor: pointer;
                font-size: 1rem;
                font-weight: bold;
                transition: all 0.3s ease;
                width: 100%;
            }

            .btn-agregar:hover {
                opacity: 0.85;
                transform: scale(1.02);
            }

            .tarjeta-favorito {
                background: var(--color-panel);
                border: 1px solid var(--color-borde);
                border-radius: 10px;
                padding: 16px;
                margin-bottom: 14px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                transition: all 0.3s ease;
                animation: entradaSlide 0.4s ease;
            }

            @@keyframes entradaSlide {
                from { opacity: 0; transform: translateX(-20px); }
                to { opacity: 1; transform: translateX(0); }
            }

            .tarjeta-favorito:hover {
                border-color: var(--color-azul);
                transform: translateX(4px);
            }

            .info-favorito h3 {
                font-size: 0.95rem;
                margin-bottom: 4px;
            }

            .info-favorito p {
                font-size: 0.8rem;
                color: #8b949e;
            }

            .btn-eliminar {
                background: transparent;
                color: var(--color-rojo);
                border: 1px solid var(--color-rojo);
                padding: 6px 12px;
                border-radius: 6px;
                cursor: pointer;
                transition: all 0.3s ease;
                font-size: 0.8rem;
            }

            .btn-eliminar:hover {
                background: var(--color-rojo);
                color: white;
            }

            .estrella {
                font-size: 1.5rem;
                margin-right: 10px;
                animation: brillar 2s ease-in-out infinite;
            }

            @@keyframes brillar {
                0%, 100% { filter: brightness(1); }
                50% { filter: brightness(1.5); }
            }
    </style>
</head>
<body>

    <header class="encabezado">
        <h1>⭐ Rutas Favoritas</h1>
        <a href="/Rutas" style="color:var(--color-azul);">← Volver al mapa</a>
    </header>

    <div class="contenedor-favoritos">

        <!-- Panel agregar -->
        <div class="panel-agregar">
            <h2 style="color:var(--color-azul); margin:0;">Agregar favorita</h2>

            <form action="/Favoritos/Agregar" method="post" style="display:flex; flex-direction:column; gap:14px;">
                <div class="campo">
                    <label>Ruta</label>
                    <select name="RutaId" id="selectRuta" onchange="actualizarNombre()">
                        @foreach (var ruta in rutas)
                        {
                            <option value="@ruta.Id" data-nombre="@ruta.Nombre">@ruta.Nombre</option>
                        }
                    </select>
                    <input type="hidden" name="NombreRuta" id="nombreRuta" value="@rutas.FirstOrDefault()?.Nombre" />
                </div>

                <div class="campo">
                    <label>Alertar cuando el tráfico sea</label>
                    <select name="NivelAlerta">
                        <option value="alto">🔴 Alto — Congestionado</option>
                        <option value="medio">🟡 Medio — Moderado</option>
                        <option value="bajo">🟢 Bajo — Fluido</option>
                    </select>
                </div>

                <button type="submit" class="btn-agregar">⭐ Agregar a favoritos</button>
            </form>

            <button onclick="verificarAlertas()" style="
                background: transparent;
                border: 1px solid var(--color-amarillo);
                color: var(--color-amarillo);
                padding: 10px;
                border-radius: 8px;
                cursor: pointer;
                transition: all 0.3s;
                font-size: 0.9rem;
                " onmouseover="this.style.background='var(--color-amarillo)'; this.style.color='black';"
                    onmouseout="this.style.background='transparent'; this.style.color='var(--color-amarillo)';">
                🔔 Verificar alertas ahora
            </button>
        </div>

        <!-- Lista favoritos -->
        <div class="panel-lista">
            <h2 style="margin-bottom:20px;">Mis rutas favoritas</h2>

            <div id="listaFavoritos">
                @if (Model.Count == 0)
                {
                    <p style="color:#555;">No tienes rutas favoritas aún.</p>
                }
                @foreach (var favorito in Model)
                {
                    <div class="tarjeta-favorito" id="favorito-@favorito.Id">
                        <div style="display:flex; align-items:center;">
                            <span class="estrella">⭐</span>
                            <div class="info-favorito">
                                <h3>@favorito.NombreRuta</h3>
                                <p>Alerta cuando: <span class="nivel-@favorito.NivelAlerta">● @favorito.NivelAlerta</span></p>
                                <p style="font-size:0.75rem; margin-top:2px;">
                                    Agregado: @favorito.CreadoEn.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </p>
                            </div>
                        </div>
                        <button class="btn-eliminar" onclick="eliminar('@favorito.Id')">
                            🗑 Eliminar
                        </button>
                    </div>
                }
            </div>
        </div>

    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="~/js/rutasFavoritas.js"></script>

</body>
</html>